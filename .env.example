# Reference values. Export the group for your chosen profile (see docs/LOCAL_SETUP.md).
# JDBC settings for a local, independently provisioned PostgreSQL database.
SPRING_PROFILES_ACTIVE=local
SHELF_DB_URL=jdbc:postgresql://localhost:5432/shelf
SHELF_DB_USER=shelf
SHELF_DB_PASSWORD=local-example-only
SHELF_API_PORT=8080
SHELF_WEB_ORIGIN=http://localhost:3000
SHELF_AUTH_SECURE_COOKIE=false

# Managed Neon deployment (neon,prod). Supply the pooled JDBC URL above and direct credentials below.
# SHELF_DB_DIRECT_URL=jdbc:postgresql://direct.example.invalid/shelf?sslmode=verify-full
# SHELF_DB_DIRECT_USER=shelf_migrator
# SHELF_DB_DIRECT_PASSWORD=example-only
# SHELF_AUTH_BASE_URL=https://auth.example.invalid/neondb/auth
# SHELF_AUTH_JWKS_URL=https://auth.example.invalid/neondb/auth/.well-known/jwks.json
# SHELF_DB_POOL_MAX=10
# SHELF_DB_POOL_MIN=0

# Dev launcher inputs supplied by neon env pull. Values below are examples only.
# NEON_BRANCH=dev
# DATABASE_URL=postgresql://user:example@pooler.example.invalid/neondb
# DATABASE_URL_UNPOOLED=postgresql://user:example@direct.example.invalid/neondb
# NEON_AUTH_BASE_URL=https://auth.example.invalid/neondb/auth
# NEON_AUTH_JWKS_URL=https://auth.example.invalid/neondb/auth/.well-known/jwks.json

# Spring-managed email and optional Google login (google profile).
SHELF_SMTP_HOST=localhost
SHELF_SMTP_PORT=587
SHELF_SMTP_USER=
SHELF_SMTP_PASSWORD=
SHELF_SMTP_AUTH=false
SHELF_SMTP_STARTTLS=false
SHELF_MAIL_FROM=no-reply@example.invalid
# SHELF_AUTH_GOOGLE_CLIENT_ID=example-client-id
# SHELF_AUTH_GOOGLE_CLIENT_SECRET=example-only

# Uploads require a private R2 bucket and a reachable private malware scanner.
SHELF_ASSETS_ENABLED=false
SHELF_R2_ACCOUNT=
SHELF_R2_BUCKET=
SHELF_R2_KEY_ID=
SHELF_R2_SECRET=
SHELF_CLAMAV_HOST=
SHELF_CLAMAV_PORT=3310
SHELF_ACCOUNT_ASSET_BYTES=8000000000
SHELF_USER_ASSET_BYTES=100000000

# Optional disposable database for HTTP tests when using native PostgreSQL.
# SHELF_TEST_DB_URL=jdbc:postgresql://localhost:5432/shelf_test
# SHELF_TEST_DB_USER=shelf_test
# SHELF_TEST_DB_PASSWORD=local-test-example

# Existing deployments can also use the following compatibility names:
# SPRING_FLYWAY_URL, SPRING_FLYWAY_USER, SPRING_FLYWAY_PASSWORD,
# SHELF_SECURE_COOKIE, SHELF_GOOGLE_CLIENT_ID, SHELF_GOOGLE_CLIENT_SECRET.
